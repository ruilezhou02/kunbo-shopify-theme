{% section 'collection-header' %}

<div class="section">
  <div class="container">
    {% paginate collection.products by 12 %}
      <div class="product-grid">
        {% for product in collection.products %}
          <div class="product-card">
            <a href="{{ product.url }}">
              <div class="product-card-image img-zoom">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
                {% else %}
                  <div style="width:100%;height:100%;background:var(--border);display:flex;align-items:center;justify-content:center;color:var(--text-muted);">产品图片</div>
                {% endif %}
              </div>
              <h3>{{ product.title }}</h3>
              <p style="color:var(--text-muted);font-size:14px;">{{ product.description | strip_html | truncate: 60 }}</p>
            </a>
          </div>
        {% else %}
          <p style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:60px 0;">暂无产品，敬请期待</p>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <div style="text-align:center;margin-top:48px;">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>
