<!-- Product Showcase — Block-based product cards -->
<section class="products-section" data-section-type="product-showcase">
  <div class="section-container">
    <div class="products-section-header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="display-md reveal reveal-delay-1">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.view_all_text != blank %}
        <a href="{{ section.settings.view_all_link }}" class="view-all reveal reveal-delay-2">
          {{ section.settings.view_all_text }} &rarr;
        </a>
      {% endif %}
    </div>

    <div class="products-grid">
      {%- for block in section.blocks -%}
        {%- capture idx -%}{{ forloop.index | modulo: 10 }}{%- endcapture -%}
        <div class="product-item reveal reveal-delay-{{ forloop.index | plus: 1 }}" {{ block.shopify_attributes }}>
          <div class="product-img-wrap">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: '800x' }}"
                   alt="{{ block.settings.title | escape }}"
                   loading="lazy"
                   width="800"
                   height="640">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="product-number">{{ forloop.index | prepend: '0' }}</span>
          </div>
          <div class="product-info">
            {% if block.settings.meta != blank %}
              <p class="product-meta">{{ block.settings.meta }}</p>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="link-underline">Learn more &rarr;</a>
            {% endif %}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Core Materials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three surfaces. Infinite possibility." },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All Products" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "default": "/collections/all" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "meta", "label": "Meta label", "default": "Flagship" },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Quartz Porcelain" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "High-density, low-porosity tiles engineered for facades, plazas, and high-traffic landscapes." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Showcase",
      "blocks": [
        { "type": "product_card", "settings": { "meta": "Flagship", "title": "Premium Quartz Porcelain", "description": "High-density, low-porosity tiles engineered for facades, plazas, and high-traffic landscapes. Frost-proof and UV-stable." } },
        { "type": "product_card", "settings": { "meta": "Architectural", "title": "Dry-Hang Cladding System", "description": "Mechanical fixed facade panels. Lightweight, ventilated, earthquake-resistant. Specified for commercial towers and civic buildings." } },
        { "type": "product_card", "settings": { "meta": "Heavy-Duty", "title": "Landscape Pavers", "description": "20\u201330mm thick. 45,000N breaking strength. Designed for vehicular loading, pool decks, and municipal plazas." } }
      ]
    }
  ]
}
{% endschema %}
