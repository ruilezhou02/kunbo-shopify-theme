<!-- Collection Header -->
<section class="collection-header-section">
  <div class="container-narrow">
    <p class="eyebrow">Products</p>
    <h1 class="display-lg">{% if collection.title != blank %}{{ collection.title }}{% else %}All Products{% endif %}</h1>
    {% if collection.description != blank %}
      <p class="body-lg" style="margin-top: 16px;">{{ collection.description }}</p>
    {% endif %}
  </div>
</section>

<section>
  <div class="collection-grid">
    {% for product in collection.products %}
      <a href="{{ product.url }}" class="collection-item">
        <div class="collection-item-image">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}">
          {% else %}
            <div style="width:100%;height:100%;background:var(--surface);"></div>
          {% endif %}
        </div>
        <h3>{{ product.title }}</h3>
        <p>{{ product.price | money }}</p>
      </a>
    {% else %}
      <p style="grid-column: 1/-1; text-align:center; color: var(--text-muted); padding: 80px 0;">No products yet. Check back soon.</p>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection Header",
  "settings": [],
  "presets": [{ "name": "Collection Header" }]
}
{% endschema %}
