<!-- Kun Bloom — Header -->
<header class="site-header" role="banner">
  <div class="header-inner">
    <a href="/" class="header-logo">
      {% if section.settings.logo_image != blank %}
        <img src="{{ section.settings.logo_image | img_url: '400x' }}" alt="{{ settings.brand_name }}">
      {% else %}
        <img src="{{ 'new-logo.png' | asset_url }}" alt="{{ settings.brand_name }}">
      {% endif %}
    </a>

    <nav class="nav-links" role="navigation">
      <a href="/" {% if template.name == 'index' %}class="active"{% endif %}>Home</a>
      <a href="/pages/about" {% if template.name == 'page' and page.handle == 'about' %}class="active"{% endif %}>About</a>
      <a href="/collections/all" {% if template.name == 'collection' %}class="active"{% endif %}>Products</a>
      <a href="/pages/projects" {% if template.name == 'page' and page.handle == 'projects' %}class="active"{% endif %}>Projects</a>
      <a href="/pages/credentials" {% if template.name == 'page' and page.handle == 'credentials' %}class="active"{% endif %}>Credentials</a>
      <a href="/pages/contact" {% if template.name == 'page' and page.handle == 'contact' %}class="active"{% endif %}>Contact</a>
    </nav>

    <button class="mobile-menu-btn" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="mobile-nav">
  <a href="/">Home</a>
  <a href="/pages/about">About</a>
  <a href="/collections/all">Products</a>
  <a href="/pages/projects">Projects</a>
  <a href="/pages/credentials">Credentials</a>
  <a href="/pages/contact">Contact</a>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    }
  ],
  "presets": [{ "name": "Header" }]
}
{% endschema %}
