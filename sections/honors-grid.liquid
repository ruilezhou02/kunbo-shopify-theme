<!-- Honors Strip — Scrolling certification showcase -->
<section class="honors-strip" data-section-type="honors-grid">
  <div class="container-wide">
    <p class="eyebrow reveal" style="text-align:center;">Credentials</p>
    <h2 class="display-md reveal reveal-delay-1" style="text-align:center; margin-bottom: var(--spacing-lg);">Certified at every level.</h2>
  </div>

  <div class="honors-scroll" style="max-width: var(--max-width); margin: 0 auto; padding: 0 var(--spacing-md);">
    <div class="honor-card reveal">
      <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001">
      <h4>ISO 9001<br>Quality Management</h4>
    </div>
    <div class="honor-card reveal reveal-delay-1">
      <img src="{{ 'env_cert_1.jpg' | asset_url }}" alt="Environmental Management">
      <h4>ISO 14001<br>Environmental</h4>
    </div>
    <div class="honor-card reveal reveal-delay-2">
      <img src="{{ 'dm_cert_1.jpg' | asset_url }}" alt="Enterprise Credit">
      <h4>AAA Enterprise<br>Credit Rating</h4>
    </div>
    <div class="honor-card reveal reveal-delay-3">
      <img src="{{ 'dm_cert_2.jpg' | asset_url }}" alt="Integrity">
      <h4>Integrity<br>Demonstration Unit</h4>
    </div>
    <div class="honor-card reveal reveal-delay-4">
      <img src="{{ 'dm_cert_3.jpg' | asset_url }}" alt="Quality Service">
      <h4>Quality Service<br>Integrity Enterprise</h4>
    </div>
    <div class="honor-card reveal">
      <img src="{{ 'dm_cert_4.jpg' | asset_url }}" alt="Contract">
      <h4>Contract-Honoring<br>&amp; Promise-Keeping</h4>
    </div>
  </div>

  <div style="text-align:center; margin-top: var(--spacing-md);">
    <a href="/pages/honors" class="link-underline reveal">View All Credentials</a>
  </div>
</section>

{% schema %}
{
  "name": "Honors Grid",
  "settings": [],
  "presets": [{ "name": "Honors Grid" }]
}
{% endschema %}
