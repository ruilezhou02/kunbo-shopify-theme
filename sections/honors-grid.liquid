<!-- Honors — Auto-scrolling certification showcase with all 13 certificates -->
<section class="honors-strip" data-section-type="honors-grid">
  <div class="container-wide">
    <p class="eyebrow reveal" style="text-align:center;">Credentials</p>
    <h2 class="display-md reveal reveal-delay-1" style="text-align:center;">Certified at every level.</h2>
  </div>

  <div class="honors-track">
    <!-- Set 1 — all 13 certificates -->
    <div class="honor-card">
      <img src="{{ 'cert-iso9001.png' | asset_url }}" alt="Quality Management System Certification" loading="lazy">
      <h4>Quality Management<br>System Certification</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'cert-ccc.png' | asset_url }}" alt="China Compulsory Product Certification" loading="lazy">
