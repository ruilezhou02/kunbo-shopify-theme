<!-- Honors — Auto-scrolling certification showcase -->
<section class="honors-strip" data-section-type="honors-grid">
  <div class="container-wide">
    <p class="eyebrow reveal" style="text-align:center;">Credentials</p>
    <h2 class="display-md reveal reveal-delay-1" style="text-align:center;">Certified at every level.</h2>
  </div>

  <div class="honors-track">
    <!-- First set -->
    <div class="honor-card">
      <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001" loading="lazy">
      <h4>ISO 9001<br>Quality Management</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'env_cert_1.jpg' | asset_url }}" alt="ISO 14001" loading="lazy">
      <h4>ISO 14001<br>Environmental</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_1.jpg' | asset_url }}" alt="Enterprise Credit Rating" loading="lazy">
      <h4>AAA Enterprise<br>Credit Rating</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_2.jpg' | asset_url }}" alt="Integrity Unit" loading="lazy">
      <h4>Integrity<br>Demonstration Unit</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_3.jpg' | asset_url }}" alt="Quality Service" loading="lazy">
      <h4>Quality Service<br>Integrity Enterprise</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_4.jpg' | asset_url }}" alt="Contract-Honoring" loading="lazy">
      <h4>Contract-Honoring<br>&amp; Promise-Keeping</h4>
    </div>

    <!-- Duplicate for infinite scroll -->
    <div class="honor-card">
      <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001" loading="lazy">
      <h4>ISO 9001<br>Quality Management</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'env_cert_1.jpg' | asset_url }}" alt="ISO 14001" loading="lazy">
      <h4>ISO 14001<br>Environmental</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_1.jpg' | asset_url }}" alt="Enterprise Credit Rating" loading="lazy">
      <h4>AAA Enterprise<br>Credit Rating</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_2.jpg' | asset_url }}" alt="Integrity Unit" loading="lazy">
      <h4>Integrity<br>Demonstration Unit</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_3.jpg' | asset_url }}" alt="Quality Service" loading="lazy">
      <h4>Quality Service<br>Integrity Enterprise</h4>
    </div>
    <div class="honor-card">
      <img src="{{ 'dm_cert_4.jpg' | asset_url }}" alt="Contract-Honoring" loading="lazy">
      <h4>Contract-Honoring<br>&amp; Promise-Keeping</h4>
    </div>
  </div>

  <div class="honors-strip-footer">
    <a href="/pages/credentials" class="link-underline reveal">View All Credentials &rarr;</a>
  </div>
</section>

{% schema %}
{
  "name": "Honors Grid",
  "settings": [
    {
      "type": "image_picker",
      "id": "cert_image_1",
      "label": "Certificate 1 — ISO 9001"
    },
    {
      "type": "image_picker",
      "id": "cert_image_2",
      "label": "Certificate 2 — ISO 14001"
    },
    {
      "type": "image_picker",
      "id": "cert_image_3",
      "label": "Certificate 3 — AAA Enterprise Credit"
    },
    {
      "type": "image_picker",
      "id": "cert_image_4",
      "label": "Certificate 4 — Integrity Unit"
    },
    {
      "type": "image_picker",
      "id": "cert_image_5",
      "label": "Certificate 5 — Quality Service"
    },
    {
      "type": "image_picker",
      "id": "cert_image_6",
      "label": "Certificate 6 — Contract-Honoring"
    }
  ],
  "presets": [{ "name": "Honors Grid" }]
}
{% endschema %}
