<!-- Honors — Static certificate grid showcasing all credentials -->
<section class="honors-strip" data-section-type="honors-grid">
  <div class="container-wide">
    <p class="eyebrow reveal" style="text-align:center;">Credentials</p>
    <h2 class="display-md reveal reveal-delay-1" style="text-align:center;">Certified at every level.</h2>
  </div>

  <div class="honors-track">
    <div class="honor-card reveal reveal-delay-1">
      <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001" loading="lazy">
      <h4>{{ section.settings.cert_1_label | default: 'ISO 9001<br>Quality Management' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-1">
      <img src="{{ 'env_cert_1.jpg' | asset_url }}" alt="ISO 14001" loading="lazy">
      <h4>{{ section.settings.cert_2_label | default: 'ISO 14001<br>Environmental' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-1">
      <img src="{{ 'dm_cert_1.jpg' | asset_url }}" alt="Enterprise Credit Rating" loading="lazy">
      <h4>{{ section.settings.cert_3_label | default: 'AAA Enterprise<br>Credit Rating' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-1">
      <img src="{{ 'dm_cert_2.jpg' | asset_url }}" alt="Integrity Unit" loading="lazy">
      <h4>{{ section.settings.cert_4_label | default: 'Integrity<br>Demonstration Unit' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-2">
      <img src="{{ 'dm_cert_3.jpg' | asset_url }}" alt="Quality Service" loading="lazy">
      <h4>{{ section.settings.cert_5_label | default: 'Quality Service<br>Integrity Enterprise' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-2">
      <img src="{{ 'dm_cert_4.jpg' | asset_url }}" alt="Contract-Honoring" loading="lazy">
      <h4>{{ section.settings.cert_6_label | default: 'Contract-Honoring<br>&amp; Promise-Keeping' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-2">
      <img src="{{ 'dm_cert_5.jpg' | asset_url }}" alt="Product Certification" loading="lazy">
      <h4>{{ section.settings.cert_7_label | default: 'Product Quality<br>Certification' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-2">
      <img src="{{ 'dm_cert_6.jpg' | asset_url }}" alt="Quality Inspection" loading="lazy">
      <h4>{{ section.settings.cert_8_label | default: 'Quality Inspection<br>Test Report' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-3">
      <img src="{{ 'dm_cert_7.jpg' | asset_url }}" alt="Industry Recognition" loading="lazy">
      <h4>{{ section.settings.cert_9_label | default: 'Industry<br>Recognition Award' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-3">
      <img src="{{ 'dm_cert_8.jpg' | asset_url }}" alt="Safety Compliance" loading="lazy">
      <h4>{{ section.settings.cert_10_label | default: 'Safety Compliance<br>Certificate' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-3">
      <img src="{{ 'dm_cert_9.jpg' | asset_url }}" alt="Material Testing" loading="lazy">
      <h4>{{ section.settings.cert_11_label | default: 'Material Testing<br>Qualification' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-3">
      <img src="{{ 'dm_cert_10.jpg' | asset_url }}" alt="Green Building" loading="lazy">
      <h4>{{ section.settings.cert_12_label | default: 'Green Building<br>Material Certification' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-4">
      <img src="{{ 'dm_cert_11.jpg' | asset_url }}" alt="Export Qualification" loading="lazy">
      <h4>{{ section.settings.cert_13_label | default: 'Export Trade<br>Qualification' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-4">
      <img src="{{ 'dm_cert_12.jpg' | asset_url }}" alt="Production License" loading="lazy">
      <h4>{{ section.settings.cert_14_label | default: 'Production<br>License' }}</h4>
    </div>
    <div class="honor-card reveal reveal-delay-4">
      <img src="{{ 'dm_cert_13.jpg' | asset_url }}" alt="Membership Certificate" loading="lazy">
      <h4>{{ section.settings.cert_15_label | default: 'Industry Association<br>Member Certificate' }}</h4>
    </div>
  </div>

  <div class="honors-strip-footer">
    <a href="/pages/credentials" class="link-underline reveal reveal-delay-4">{{ section.settings.view_all_text | default: 'View All Credentials' }} &rarr;</a>
  </div>
</section>

