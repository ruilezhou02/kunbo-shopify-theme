<!-- Honors — Auto-scrolling certification showcase -->
<section class="honors-strip" data-section-type="honors-grid">
  <div class="container-wide">
    <p class="eyebrow reveal" style="text-align:center;">{{ section.settings.eyebrow }}</p>
    <h2 class="display-md reveal reveal-delay-1" style="text-align:center;">{{ section.settings.heading }}</h2>
  </div>

  <div class="honors-track">
    <div class="honor-card">
      {% if section.settings.cert_image_1 != blank %}
        <img src="{{ section.settings.cert_image_1 | img_url: '400x' }}" alt="ISO 9001">
      {% else %}
        <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001">
      {% endif %}
      <h4>{{ section.settings.cert_1_title | newline_to_br }}</h4>
    </div>
    <div class="honor-card">
      {% if section.settings.cert_image_2 != blank %}
        <img src="{{ section.settings.cert_image_2 | img_url: '400x' }}" alt="{{ section.settings.cert_2_title | escape }}">
      {% else %}
        <img src="{{ 'env_cert_1.jpg' | asset_url }}" alt="Environmental Management">
      {% endif %}
      <h4>{{ section.settings.cert_2_title | newline_to_br }}</h4>
    </div>
    <div class="honor-card">
      {% if section.settings.cert_image_3 != blank %}
        <img src="{{ section.settings.cert_image_3 | img_url: '400x' }}" alt="{{ section.settings.cert_3_title | escape }}">
      {% else %}
        <img src="{{ 'dm_cert_1.jpg' | asset_url }}" alt="Enterprise Credit">
      {% endif %}
      <h4>{{ section.settings.cert_3_title | newline_to_br }}</h4>
    </div>
    <div class="honor-card">
      {% if section.settings.cert_image_4 != blank %}
        <img src="{{ section.settings.cert_image_4 | img_url: '400x' }}" alt="{{ section.settings.cert_4_title | escape }}">
      {% else %}
        <img src="{{ 'dm_cert_2.jpg' | asset_url }}" alt="Integrity">
      {% endif %}
      <h4>{{ section.settings.cert_4_title | newline_to_br }}</h4>
    </div>
    <div class="honor-card">
      {% if section.settings.cert_image_5 != blank %}
        <img src="{{ section.settings.cert_image_5 | img_url: '400x' }}" alt="{{ section.settings.cert_5_title | escape }}">
      {% else %}
        <img src="{{ 'dm_cert_3.jpg' | asset_url }}" alt="Quality Service">
      {% endif %}
      <h4>{{ section.settings.cert_5_title | newline_to_br }}</h4>
    </div>
    <div class="honor-card">
      {% if section.settings.cert_image_6 != blank %}
        <img src="{{ section.settings.cert_image_6 | img_url: '400x' }}" alt="{{ section.settings.cert_6_title | escape }}">
      {% else %}
        <img src="{{ 'dm_cert_4.jpg' | asset_url }}" alt="Contract">
      {% endif %}
      <h4>{{ section.settings.cert_6_title | newline_to_br }}</h4>
    </div>
  </div>

  <div style="text-align:center; margin-top: var(--spacing-lg);">
    <a href="{{ section.settings.view_all_link }}" class="link-underline reveal">{{ section.settings.view_all_text }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Honors Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Credentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Certified at every level."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All — Text",
      "default": "View All Credentials"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All — Link",
      "default": "/pages/honors"
    },
    {
      "type": "header",
      "content": "Certificate Cards"
    },
    {
      "type": "image_picker",
      "id": "cert_image_1",
      "label": "Cert 1 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_1_title",
      "label": "Cert 1 — Title (line 1\nline 2)",
      "default": "ISO 9001\nQuality Management"
    },
    {
      "type": "image_picker",
      "id": "cert_image_2",
      "label": "Cert 2 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_2_title",
      "label": "Cert 2 — Title (line 1\nline 2)",
      "default": "ISO 14001\nEnvironmental"
    },
    {
      "type": "image_picker",
      "id": "cert_image_3",
      "label": "Cert 3 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_3_title",
      "label": "Cert 3 — Title (line 1\nline 2)",
      "default": "AAA Enterprise\nCredit Rating"
    },
    {
      "type": "image_picker",
      "id": "cert_image_4",
      "label": "Cert 4 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_4_title",
      "label": "Cert 4 — Title (line 1\nline 2)",
      "default": "Integrity\nDemonstration Unit"
    },
    {
      "type": "image_picker",
      "id": "cert_image_5",
      "label": "Cert 5 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_5_title",
      "label": "Cert 5 — Title (line 1\nline 2)",
      "default": "Quality Service\nIntegrity Enterprise"
    },
    {
      "type": "image_picker",
      "id": "cert_image_6",
      "label": "Cert 6 — Image"
    },
    {
      "type": "textarea",
      "id": "cert_6_title",
      "label": "Cert 6 — Title (line 1\nline 2)",
      "default": "Contract-Honoring\n& Promise-Keeping"
    }
  ],
  "presets": [{ "name": "Honors Grid" }]
}
{% endschema %}