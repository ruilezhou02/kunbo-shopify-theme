<!-- Honors Grid — Block-based cert cards -->
<section class="honors-section" data-section-type="honors-grid">
  <div class="section-container">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow reveal" style="text-align:center;">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="display-md reveal reveal-delay-1" style="text-align:center;">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="honors-track-wrapper">
      <div class="honors-track">
        {%- for block in section.blocks -%}
          <div class="honor-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: '400x' }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {%- endif -%}
            <h4>{{ block.settings.title | newline_to_br }}</h4>
          </div>
        {%- endfor -%}
        {%- for block in section.blocks -%}
          <div class="honor-card" aria-hidden="true">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | img_url: '400x' }}" alt="" loading="lazy">
            {%- endif -%}
            <h4>{{ block.settings.title | newline_to_br }}</h4>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {% if section.settings.view_all_text != blank %}
      <div style="text-align:center; margin-top:3rem;">
        <a href="{{ section.settings.view_all_link }}" class="link-underline reveal">{{ section.settings.view_all_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Honors Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Credentials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Certified at every level." },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All Credentials" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "default": "/pages/honors" }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Certificate Image" },
        { "type": "textarea", "id": "title", "label": "Name", "default": "ISO 9001\nQuality Management" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Honors Grid",
      "blocks": [
        { "type": "certificate", "settings": { "title": "ISO 9001\nQuality Management" } },
        { "type": "certificate", "settings": { "title": "ISO 14001\nEnvironmental" } },
        { "type": "certificate", "settings": { "title": "AAA Enterprise\nCredit Rating" } },
        { "type": "certificate", "settings": { "title": "Integrity\nDemonstration Unit" } },
        { "type": "certificate", "settings": { "title": "Quality Service\nIntegrity Enterprise" } },
        { "type": "certificate", "settings": { "title": "Contract-Honoring\n& Promise-Keeping" } }
      ]
    }
  ]
}
{% endschema %}
