<!-- About Split — Full-bleed architectural layout -->
<section data-section-type="about-split">
  <div class="about-split">
    <div class="about-split-image">
      <img src="{{ 'about-split-stairs.jpg' | asset_url }}" alt="Kun Bloom Architectural Stairs">
    </div>
    <div class="about-split-content">
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="display-md reveal reveal-delay-1">{{ section.settings.heading_line1 }}<br>{{ section.settings.heading_line2 }}</h2>
      <div class="reveal reveal-delay-2">{{ section.settings.body_text | newline_to_br }}</div>
      <div class="reveal reveal-delay-3">{{ section.settings.body_text_2 | newline_to_br }}</div>
      <a href="{{ section.settings.link_url }}" class="link-underline reveal reveal-delay-4">{{ section.settings.link_text }}</a>
    </div>
  </div>

  <!-- Stats Strip with count-up -->
  <div class="stats-strip">
    <div class="stat-item reveal">
      <div class="stat-number" data-target="{{ section.settings.stat1_number }}"><span class="stat-suffix">{{ section.settings.stat1_suffix }}</span></div>
      <div class="stat-label">{{ section.settings.stat1_label }}</div>
    </div>
    <div class="stat-item reveal reveal-delay-1">
      <div class="stat-number" data-target="{{ section.settings.stat2_number }}"></div>
      <div class="stat-label">{{ section.settings.stat2_label }}</div>
    </div>
    <div class="stat-item reveal reveal-delay-2">
      <div class="stat-number" data-target="{{ section.settings.stat3_number }}"><span class="stat-suffix">{{ section.settings.stat3_suffix }}</span></div>
      <div class="stat-label">{{ section.settings.stat3_label }}</div>
    </div>
    <div class="stat-item reveal reveal-delay-3">
      <div class="stat-number" data-target="{{ section.settings.stat4_text }}">{{ section.settings.stat4_text }}</div>
      <div class="stat-label">{{ section.settings.stat4_label }}</div>
    </div>
  </div>

  <!-- About Us — Company Profile -->
  <div class="about-us-profile">
    <div class="container-narrow">
      <p class="eyebrow reveal">{{ section.settings.about_eyebrow }}</p>
      <div class="about-us-grid">
        <div class="about-us-col reveal reveal-delay-1">
          <p class="body-lg" style="margin-top: 0;">{{ section.settings.about_intro }}</p>
        </div>
        <div class="about-us-col reveal reveal-delay-2">
          {{ section.settings.about_body }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Split + Stats",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Studio"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — Line 1",
      "default": "Material intelligence,"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — Line 2",
      "default": "shaped by discipline."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text — Paragraph 1",
      "default": "Founded in 2010 with a singular obsession: to elevate architectural ceramics beyond commodity. Our R&D team holds 14 national patents. Our products are installed in over 1,000 projects across China, Southeast Asia, and the Middle East."
    },
    {
      "type": "textarea",
      "id": "body_text_2",
      "label": "Body Text — Paragraph 2",
      "default": "We work with architects, not against their vision. Every surface we produce is a collaboration between material science and spatial intent."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Learn About Us"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "default": "/pages/about"
    },
    {
      "type": "header",
      "content": "Stat 1"
    },
    {
      "type": "text",
      "id": "stat1_number",
      "label": "Number",
      "default": "15"
    },
    {
      "type": "text",
      "id": "stat1_suffix",
      "label": "Suffix (e.g. +)",
      "default": "+"
    },
    {
      "type": "text",
      "id": "stat1_label",
      "label": "Label",
      "default": "Years of Craft"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat2_number",
      "label": "Number",
      "default": "14"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Label",
      "default": "National Patents"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat3_number",
      "label": "Number",
      "default": "1000"
    },
    {
      "type": "text",
      "id": "stat3_suffix",
      "label": "Suffix (e.g. +)",
      "default": "+"
    },
    {
      "type": "text",
      "id": "stat3_label",
      "label": "Label",
      "default": "Projects Completed"
    },
    {
      "type": "header",
      "content": "Stat 4"
    },
    {
      "type": "text",
      "id": "stat4_text",
      "label": "Text (non-numeric)",
      "default": "ISO"
    },
    {
      "type": "text",
      "id": "stat4_label",
      "label": "Label",
      "default": "Certified Quality"
    },
    {
      "type": "header",
      "content": "About Us — Company Profile"
    },
    {
      "type": "text",
      "id": "about_eyebrow",
      "label": "About Eyebrow",
      "default": "About Us"
    },
    {
      "type": "textarea",
      "id": "about_intro",
      "label": "About Intro (left column)",
      "default": "With over 15 years of expertise in building materials, we are dedicated to providing global clients with high-quality quartz tiles and architectural façade solutions."
    },
    {
      "type": "richtext",
      "id": "about_body",
      "label": "About Body (right column)",
      "default": "<p>Chongqing Kun Bloom Building Materials Co., Ltd. was founded in 2010 by an industry veteran with deep domain experience. Backed by rigorous R&D, precise process control, and craftsmanship benchmarked against industry-leading standards, Kun Bloom has grown into a competitive brand recognized for both reputation and strength within the quartz tile industry.</p><p>Kun Bloom holds multiple utility model patents (Nos. 2022221017708 and 2022230576778), and all products strictly comply with national standards GB 6566-2010 and GB/T 4100-2015. Our partner production bases, located in China's Foshan and Quanzhou regions, benefit from a complete industrial chain and efficient logistics network — all focused on delivering high-quality wall and floor quartz tile products.</p>"
    }
  ],
  "presets": [{ "name": "About Split + Stats" }]
}
{% endschema %}