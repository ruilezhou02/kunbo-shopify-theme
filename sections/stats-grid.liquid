<!-- Stats Grid Section -->
<section class="section bg-white" style="border-bottom:1px solid var(--border-light);">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-number">15+</div>
        <div class="stat-label">行业经验 / 年</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number">2+</div>
        <div class="stat-label">核心专利 / 项</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number">20+</div>
        <div class="stat-label">工艺面层 / 种</div>
      </div>
      <div class="stat-item reveal">
        <div class="stat-number">1000+</div>
        <div class="stat-label">服务项目 / 个</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stats Grid",
  "settings": [],
  "presets": [{ "name": "Stats Grid", "category": "Kun Bloom" }]
}
{% endschema %}
