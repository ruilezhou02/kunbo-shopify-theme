<!-- Contact Page Section -->
<section style="padding-top:120px;padding-bottom:60px;background:var(--bg-light);">
  <div class="container">
    <div class="reveal">
      <h1 style="font-family:var(--font-heading);font-size:clamp(28px, 5vw, 48px);font-weight:700;margin-bottom:16px;">联系我们</h1>
      <p style="font-size:18px;color:var(--text-muted);max-width:640px;">期待与您的合作，无论是咨询产品、索取样板还是项目合作，我们都将竭诚为您服务。</p>
    </div>
  </div>
</section>

<section class="section bg-white">
  <div class="container">
    <div class="reveal" style="display:grid;grid-template-columns:1fr 1fr;gap:80px;">

      <!-- Contact Info -->
      <div>
        <p class="section-label">联系方式</p>
        <h3 style="font-family:var(--font-heading);font-size:28px;font-weight:700;margin-bottom:40px;">随时与我们沟通</h3>
        
        <div style="display:flex;flex-direction:column;gap:32px;">
          <div style="display:flex;gap:16px;align-items:flex-start;">
            <div style="width:48px;height:48px;background:rgba(var(--primary-rgb),0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h4 style="font-family:var(--font-heading);font-size:14px;font-weight:600;margin-bottom:4px;">公司地址</h4>
              <p style="color:var(--text-muted);font-size:14px;">{{ settings.contact_address }}</p>
            </div>
          </div>

          <div style="display:flex;gap:16px;align-items:flex-start;">
            <div style="width:48px;height:48px;background:rgba(var(--primary-rgb),0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            </div>
            <div>
              <h4 style="font-family:var(--font-heading);font-size:14px;font-weight:600;margin-bottom:4px;">联系电话</h4>
              <p style="color:var(--text-muted);font-size:14px;">{{ settings.contact_phone }}</p>
            </div>
          </div>

          <div style="display:flex;gap:16px;align-items:flex-start;">
            <div style="width:48px;height:48px;background:rgba(var(--primary-rgb),0.08);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <h4 style="font-family:var(--font-heading);font-size:14px;font-weight:600;margin-bottom:4px;">电子邮箱</h4>
              <p style="color:var(--text-muted);font-size:14px;">{{ settings.contact_email }}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div>
        <p class="section-label">在线留言</p>
        <h3 style="font-family:var(--font-heading);font-size:28px;font-weight:700;margin-bottom:40px;">期待您的来信</h3>
        
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div style="background:rgba(212,175,55,0.1);border:1px solid var(--accent);padding:20px;margin-bottom:24px;color:var(--text);font-size:14px;">
              ✓ 感谢您的留言，我们将尽快与您联系！
            </div>
          {% endif %}

          {{ form.errors | default_errors }}

          <div class="contact-form">
            <div class="form-group">
              <label for="contact-name">姓名</label>
              <input type="text" id="contact-name" name="contact[name]" placeholder="您的姓名" required>
            </div>
            <div class="form-group">
              <label for="contact-email">邮箱</label>
              <input type="email" id="contact-email" name="contact[email]" placeholder="your@email.com" required>
            </div>
            <div class="form-group">
              <label for="contact-phone">电话（选填）</label>
              <input type="tel" id="contact-phone" name="contact[phone]" placeholder="您的电话号码">
            </div>
            <div class="form-group">
              <label for="contact-message">留言内容</label>
              <textarea id="contact-message" name="contact[body]" placeholder="请描述您的需求，我们将为您提供专业的产品建议和解决方案。" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;padding:16px 40px;font-size:14px;">
              提交留言
            </button>
          </div>
        {% endform %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": [],
  "presets": [{ "name": "Contact Page", "category": "Kun Bloom" }]
}
{% endschema %}
