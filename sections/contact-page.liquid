<!-- Contact Page -->
<section class="page-hero">
  <div class="container-narrow">
    <p class="eyebrow">Contact</p>
    <h1 class="display-lg">Begin a<br>conversation.</h1>
    <p class="body-lg">For project inquiries, sample requests, or technical specifications, reach out directly.</p>
  </div>
</section>

<section class="page-section">
  <div class="contact-layout">
    <div>
      <div class="contact-info-item">
        <h4>Email</h4>
        <p>chongqingkunbo@163.com</p>
      </div>
      <div class="contact-info-item">
        <h4>Phone</h4>
        <p>+86 023-67646148</p>
      </div>
      <div class="contact-info-item">
        <h4>Address</h4>
        <p>Chongqing, China</p>
      </div>
      <div class="contact-info-item">
        <h4>WeChat</h4>
        <p>Scan to connect with our team for real-time project consultation.</p>
      </div>
    </div>

    <div>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p style="color: var(--accent); font-size: 15px;">Thank you. We'll be in touch within 24 hours.</p>
        {% else %}
          <div class="contact-form-group">
            <label for="contact-name">Name</label>
            <input type="text" id="contact-name" name="contact[name]" required>
          </div>
          <div class="contact-form-group">
            <label for="contact-email">Email</label>
            <input type="email" id="contact-email" name="contact[email]" required>
          </div>
          <div class="contact-form-group">
            <label for="contact-company">Company / Studio</label>
            <input type="text" id="contact-company" name="contact[company]">
          </div>
          <div class="contact-form-group">
            <label for="contact-message">Project Details</label>
            <textarea id="contact-message" name="contact[body]" required></textarea>
          </div>
          <button type="submit" class="submit-btn">Send Inquiry</button>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>
