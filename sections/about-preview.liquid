<!-- Brand Statement — Editorial centerpiece with gradient veil -->
<section class="statement-section{% if section.settings.bg_image != blank %} has-statement-bg{% endif %}" data-section-type="brand-statement">
  {% if section.settings.bg_image != blank %}
    <div class="statement-section__bg" style="background-image: url({{ section.settings.bg_image | img_url: '2000x' }})"></div>
    <div class="statement-section__overlay"></div>
  {% endif %}
  <div class="statement-section__inner{% if section.settings.bg_image != blank %} statement-section__inner--editorial{% endif %}">
    <div class="statement-section__content">
      <span class="statement-section__line reveal"></span>
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="statement-section__heading reveal reveal-delay-1">{{ section.settings.heading | newline_to_br }}</h2>
      <p class="statement-section__body reveal reveal-delay-2">{{ section.settings.body_text }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Statement",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "We don't manufacture tiles.\nWe compose surfaces that define space."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Every slab of Kun Bloom quartz porcelain carries 15 years of material science, tested across thousands of architectural projects. Understated. Engineered. Built to outlast trends."
    }
  ],
  "presets": [{ "name": "Brand Statement" }]
}
{% endschema %}
