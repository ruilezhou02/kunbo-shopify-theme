<!-- Brand Statement — Editorial centerpiece -->
<section class="statement-section" data-section-type="brand-statement">
  <div class="container-narrow">
    <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
    <h2 class="display-md reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    <p class="body-lg reveal reveal-delay-2">{{ section.settings.body_text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Brand Statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "We don't manufacture tiles.\nWe compose surfaces that define space."
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Every slab of Kun Bloom quartz porcelain carries 15 years of material science, tested across thousands of architectural projects. Understated. Engineered. Built to outlast trends."
    }
  ],
  "presets": [{ "name": "Brand Statement" }]
}
{% endschema %}