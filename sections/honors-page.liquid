<!-- Honors & Credentials Page -->
<section class="page-hero">
  <div class="container-narrow">
    <p class="eyebrow">Credentials</p>
    <h1 class="display-lg">Certified at every level.</h1>
    <p class="body-lg">Industry recognition, national certifications, and independent quality audits &mdash; all publicly verifiable.</p>
  </div>
</section>

<section class="page-section">
  <div class="container-wide">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px;">
      {% assign cert_images = "iso9001.jpg,env_cert_1.jpg,dm_cert_1.jpg,dm_cert_2.jpg,dm_cert_3.jpg,dm_cert_4.jpg,dm_cert_5.jpg,dm_cert_6.jpg,dm_cert_7.jpg,dm_cert_8.jpg,dm_cert_9.jpg,dm_cert_10.jpg,dm_cert_11.jpg,dm_cert_12.jpg,dm_cert_13.jpg" | split: ',' %}
      {% assign cert_names = "ISO 9001 Quality Management,ISO 14001 Environmental Management,AAA Enterprise Credit Rating,Integrity Demonstration Unit,Quality Service Integrity,Contract-Honoring Enterprise,Credit Rating Certificate,Quality-Focused Enterprise,Service-Focused Enterprise,Integrity Entrepreneur,Integrity Manager,Trustworthy Enterprise,Industry Standard Contributor,China Green Product,P.R.C. Enterprise Certificate" | split: ',' %}

      {% for cert_img in cert_images %}
        <div style="padding: 28px 20px; border: 1px solid var(--border); text-align: center; transition: all 0.3s ease; background: var(--white);">
          <img src="{{ cert_img | strip | asset_url }}" alt="{{ cert_names[forloop.index0] }}" style="width: 100%; height: 160px; object-fit: contain; margin-bottom: 16px; opacity: 0.85;">
          <h4 style="font-family: var(--font-body); font-size: 12px; font-weight: 500; line-height: 1.5; color: var(--text);">{{ cert_names[forloop.index0] }}</h4>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
