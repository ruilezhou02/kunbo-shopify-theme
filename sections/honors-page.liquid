<!-- Honors & Credentials Page — Reference layout: left-aligned hero + 4-column certificate grid -->
<section class="page-hero honors-hero">
  <div class="container-wide">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="display-lg">{{ section.settings.title }}</h1>
    <p class="body-lg">{{ section.settings.intro }}</p>
  </div>
</section>

<section class="page-section honors-section">
  <div class="container-wide">
    <div class="honors-grid">
      {% for block in section.blocks %}
        <article class="honor-card" {{ block.shopify_attributes }}>
          <div class="honor-card-image">
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.title }}" loading="lazy">
            {% else %}
              <div class="honor-card-placeholder">
                <span>{{ block.settings.year | default: '2022' }}</span>
              </div>
            {% endif %}
          </div>
          <div class="honor-card-info">
            <span class="honor-year">{{ block.settings.year }}</span>
            {% if block.settings.meta != blank %}
              <p class="honor-meta">{{ block.settings.meta }}</p>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Honors Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Credentials"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Honors & Qualifications"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Recognized by industry authorities and the market for product strength and consistent performance."
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Certificate Image"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2022"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Category Tag",
          "default": "Certification"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Test Report"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Building material quality inspection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Honors Page",
      "blocks": [
        { "type": "certificate", "settings": { "year": "2022", "meta": "Certification", "title": "ISO 9001", "description": "Quality management system certification" } },
        { "type": "certificate", "settings": { "year": "2022", "meta": "Certification", "title": "ISO 14001", "description": "Environmental management system" } },
        { "type": "certificate", "settings": { "year": "2023", "meta": "Certification", "title": "AAA Enterprise Credit", "description": "Enterprise credit rating certificate" } },
        { "type": "certificate", "settings": { "year": "2023", "meta": "Certification", "title": "Integrity Unit", "description": "Integrity demonstration enterprise" } }
      ]
    }
  ]
}
{% endschema %}
