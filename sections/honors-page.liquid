        {% else %}
          <img src="{{ 'iso9001.jpg' | asset_url }}" alt="ISO 9001 Quality Management" style="width: 100%; height: 160px; object-fit: contain; margin-bottom: 16px; opacity: 0.85;">
        {% endif %}
        <h4 style="font-family: var(--font-body); font-size: 12px; font-weight: 500; line-height: 1.5; color: var(--text);">ISO 9001 Quality Management</h4>
