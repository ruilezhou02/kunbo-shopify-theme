          <div class="honor-card-image">
            <img src="{{ 'cert-porcelain-test-2.png' | asset_url }}" alt="Porcelain Tile Testing Report II" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Test Report</p>
            <h3>Porcelain Tile Testing Report II</h3>
            <p>Independent laboratory testing &amp; verification</p>
          </div>
        </article>
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-glazed-tile-test.png' | asset_url }}" alt="Glazed Porcelain Tile Testing Report" loading="lazy">
          </div>
