<!-- Honors & Credentials Page — All certificate images displayed as a large static grid -->
<section class="page-hero honors-hero">
  <div class="container-wide">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="display-lg">{{ section.settings.title }}</h1>
    <p class="body-lg">{{ section.settings.intro }}</p>
  </div>
</section>

<section class="page-section honors-section">
  <div class="container-wide">
    <div class="honors-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <article class="honor-card" {{ block.shopify_attributes }}>
            <div class="honor-card-image">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                <div class="honor-card-placeholder">
                  <span>{{ block.settings.year | default: '—' }}</span>
                </div>
              {% endif %}
            </div>
            <div class="honor-card-info">
              <span class="honor-year">{{ block.settings.year }}</span>
              {% if block.settings.meta != blank %}
                <p class="honor-meta">{{ block.settings.meta }}</p>
              {% endif %}
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        <!-- Fallback: all 13 certificates from local folder -->
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-iso9001.png' | asset_url }}" alt="Quality Management System Certification" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Certification</p>
            <h3>Quality Management System Certification</h3>
            <p>ISO 9001 Quality Management System</p>
          </div>
        </article>
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-ccc.png' | asset_url }}" alt="China Compulsory Product Certification" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Certification</p>
            <h3>China Compulsory Product Certification</h3>
            <p>CCC National mandatory product certification</p>
          </div>
        </article>
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-product-quality.png' | asset_url }}" alt="Product Quality Certificate" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Certification</p>
            <h3>Product Quality Certificate</h3>
            <p>Product quality compliance certification</p>
          </div>
        </article>
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-radioactivity.png' | asset_url }}" alt="Building Material Radioactivity Inspection Certificate" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Certification</p>
            <h3>Building Material Radioactivity Inspection Certificate</h3>
            <p>Radioactivity compliance for building materials</p>
          </div>
        </article>
        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-taxpayer.png' | asset_url }}" alt="Class A Taxpayer Enterprise" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2023</span>
            <p class="honor-meta">Qualification</p>
            <h3>Class A Taxpayer Enterprise</h3>
