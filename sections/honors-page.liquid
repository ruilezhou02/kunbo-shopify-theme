        <article class="honor-card">
          <div class="honor-card-image">
            <img src="{{ 'cert-wall-insulation.png' | asset_url }}" alt="Building Wall Insulation Material Testing Report" loading="lazy">
          </div>
          <div class="honor-card-info">
            <span class="honor-year">2022</span>
            <p class="honor-meta">Test Report</p>
            <h3>Building Wall Insulation Material Testing Report</h3>
            <p>Independent laboratory testing &amp; verification</p>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Honors Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Credentials"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Honors & Qualifications"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Recognized by industry authorities and the market for product strength and consistent performance."
    }
  ],
  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Certificate Image"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2022"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Category Tag",
          "default": "Certification"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Test Report"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Building material quality inspection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Honors Page"
    }
  ]
}
{% endschema %}
