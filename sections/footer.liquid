<!-- Footer — Block-based -->
<footer class="site-footer" role="contentinfo">
  <div class="footer-grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer-brand" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>

        {%- when 'menu' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <ul>
                {%- for i in (1..5) -%}
                  <li><a href="#">Link {{ i }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <div class="footer-text">{{ block.settings.text | newline_to_br }}</div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer-bottom">
    &copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: 'Kun Bloom' }}. All rights reserved.
    {% if section.settings.show_policy_links %}
      <div class="footer-policies">
        {%- for policy in shop.policies -%}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
          {% unless forloop.last %}<span>&nbsp;|&nbsp;</span>{% endunless %}
        {%- endfor -%}
      </div>
    {% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand Info",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Brand name", "default": "Kun Bloom" },
        { "type": "textarea", "id": "text", "label": "Brand description", "default": "Architectural stone surfaces. Precision-engineered in Chongqing, China. Shipped worldwide." }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Navigate" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Chongqing, China\n023-67646148\nsuli@kunbloom.com" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Navigate" } },
        { "type": "text", "settings": { "heading": "Contact", "text": "Chongqing, China\n023-67646148\nsuli@kunbloom.com" } }
      ]
    }
  ]
}
{% endschema %}
