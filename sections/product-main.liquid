<!-- Product Detail Section -->
<section style="padding-top:120px;" class="bg-white">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;">

      <!-- Product Image -->
      <div>
        {% if product.featured_image %}
          <div style="aspect-ratio:1;background:var(--bg-light);overflow:hidden;">
            <img src="{{ product.featured_image | img_url: '1200x' }}" alt="{{ product.title }}" style="width:100%;height:100%;object-fit:cover;">
          </div>
        {% else %}
          <div style="aspect-ratio:1;background:var(--bg-light);display:flex;align-items:center;justify-content:center;color:var(--text-muted);">Product Image</div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div>
        <h1 style="font-family:var(--font-heading);font-size:clamp(24px, 4vw, 36px);font-weight:700;margin-bottom:16px;">{{ product.title }}</h1>
        
        {% if product.price > 0 %}
          <p style="font-family:var(--font-heading);font-size:28px;font-weight:700;color:var(--primary);margin-bottom:24px;">
            {{ product.price | money }}
          </p>
        {% endif %}

        <div style="color:var(--text-muted);line-height:1.8;margin-bottom:32px;">
          {{ product.description }}
        </div>

        {% form 'product', product %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn-primary" style="width:100%;padding:16px 40px;font-size:14px;" {% unless product.available %}disabled style="opacity:0.5;cursor:not-allowed;"{% endunless %}>
            {% if product.available %}加入询价{% else %}暂不可用{% endif %}
          </button>
        {% endform %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Main",
  "settings": [],
  "presets": [{ "name": "Product Main", "category": "Kun Bloom" }]
}
{% endschema %}
