<!-- Product Detail — Full-width editorial layout -->
<section class="product-detail-new">
  <div class="product-detail__layout">

    <!-- Back nav -->
    <div class="product-detail__nav">
      <a href="javascript:history.back()" class="product-detail__back">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M7 2L3 6L7 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back
      </a>
    </div>

    <!-- Image Gallery — full width, natural aspect ratio -->
    <div class="product-detail__gallery">
      <div class="product-gallery-main">
        {% if product.featured_image %}
          <img src="{{ product.featured_image | img_url: 'master' }}"
               alt="{{ product.title | escape }}"
               id="product-main-image"
               class="product-main-photo">
        {% else %}
          <div class="product-gallery-placeholder"></div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="product-gallery-thumbs">
          {% for image in product.images %}
            <button class="product-thumb{% if forloop.first %} active{% endif %}"
                    onclick="var mainImg=document.getElementById('product-main-image'); mainImg.src='{{ image | img_url: 'master' }}'; document.querySelectorAll('.product-thumb').forEach(t=>t.classList.remove('active')); this.classList.add('active');">
              <img src="{{ image | img_url: '200x' }}" alt="{{ image.alt | escape }}">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info — centered editorial block below image -->
    <div class="product-detail__info">
      {% if product.type != blank %}
        <p class="product-detail__code">{{ product.type }}</p>
      {% endif %}

      <h1 class="product-detail__title">{{ product.title }}</h1>

      <!-- Variant Selector -->
      {% if product.variants.size > 1 %}
        <div class="product-variant-selector">
          <h4 class="product-detail__label">Specification</h4>
          <div class="variant-options">
            {% for variant in product.variants %}
              <button class="variant-btn{% if variant.id == product.selected_or_first_available_variant.id %} active{% endif %}"
                      data-variant-id="{{ variant.id }}"
                      data-variant-price="{{ variant.price | money }}"
                      data-variant-sku="{{ variant.sku }}"
                      onclick="handleVariantChange(this, '{{ variant.id }}', '{{ variant.price | money }}', '{{ variant.sku }}')"
                      {% unless variant.available %}disabled{% endunless %}>
                <span class="variant-btn__label">{{ variant.title }}</span>
                {% if variant.sku != blank %}
                  <span class="variant-btn__sku">{{ variant.sku }}</span>
                {% endif %}
              </button>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- Description / Specs -->
      <div class="product-detail__description">
        {% if product.description != blank %}
          {{ product.description }}
        {% endif %}
      </div>

      <!-- Add to Inquiry -->
      <a href="/pages/contact{% if product.selected_or_first_available_variant.sku != blank %}?product={{ product.title | url_encode }}&sku={{ product.selected_or_first_available_variant.sku | url_encode }}{% endif %}"
         class="inquiry-btn"
         id="inquiry-link">
        <span>{% if product.available %}Add to Inquiry{% else %}Sold Out{% endif %}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8H13M10 5L13 8L10 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>

      <!-- Variant SKU display -->
      <p class="product-detail__variant-sku" id="variant-sku-display">
        {% if product.selected_or_first_available_variant.sku != blank %}
          SKU: {{ product.selected_or_first_available_variant.sku }}
        {% endif %}
      </p>
    </div>
  </div>
</section>

<script>
function handleVariantChange(btn, variantId, price, sku) {
  document.querySelectorAll('.variant-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  var inquiryLink = document.getElementById('inquiry-link');
  if (inquiryLink && sku) {
    var productName = encodeURIComponent(btn.closest('.product-detail__info').querySelector('.product-detail__title').textContent);
    inquiryLink.href = '/pages/contact?product=' + productName + '&sku=' + encodeURIComponent(sku);
  }
  var skuDisplay = document.getElementById('variant-sku-display');
  if (skuDisplay && sku) {
    skuDisplay.textContent = 'SKU: ' + sku;
    skuDisplay.style.display = 'block';
  }
}
</script>

{% schema %}
{
  "name": "Product Main",
  "settings": [],
  "presets": [{ "name": "Product Main" }]
}
{% endschema %}
