<!-- Product Detail -->
<section class="product-detail">
  <div class="product-layout">
    <div class="product-image-main">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '1200x' }}" alt="{{ product.title }}">
      {% else %}
        <div style="width:100%;height:100%;background:var(--surface);"></div>
      {% endif %}
    </div>
    <div class="product-info">
      <h1>{{ product.title }}</h1>
      <div class="product-price">{{ product.price | money }}</div>
      <div class="product-description">{{ product.description }}</div>

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="add-to-cart-btn" {% unless product.available %}disabled{% endunless %}>
          {% if product.available %}Add to Inquiry{% else %}Sold Out{% endif %}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Main",
  "settings": [],
  "presets": [{ "name": "Product Main" }]
}
{% endschema %}
