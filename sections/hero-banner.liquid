<!-- Hero Banner Section -->
{% assign hero_image = section.settings.hero_image %}
{% assign hero_mobile = section.settings.hero_image_mobile %}

<section class="hero-section" style="position:relative;height:100vh;min-height:600px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
  
  <!-- Background -->
  <div style="position:absolute;inset:0;z-index:0;">
    {% if hero_image != blank %}
      {% if hero_mobile != blank %}
        <picture>
          <source media="(max-width:768px)" srcset="{{ hero_mobile | img_url: 'master' }}">
          <img src="{{ hero_image | img_url: 'master' }}" 
               alt="{{ settings.brand_name }}" 
               style="width:100%;height:100%;object-fit:cover;">
        </picture>
      {% else %}
        <img src="{{ hero_image | img_url: 'master' }}" 
             alt="{{ settings.brand_name }}" 
             style="width:100%;height:100%;object-fit:cover;">
      {% endif %}
    {% else %}
      <img src="{{ 'hero.jpeg' | asset_url }}"
           alt="{{ settings.brand_name }}" 
           style="width:100%;height:100%;object-fit:cover;">
    {% endif %}
    <div style="position:absolute;inset:0;background:rgba(0,0,0,0.35);backdrop-filter:blur(1px);"></div>
  </div>

  <!-- Content -->
  <div class="container reveal-fade" style="position:relative;z-index:10;text-align:center;color:white;max-width:800px;">
    <h1 style="font-family:var(--font-heading);font-size:clamp(32px, 5vw, 64px);font-weight:700;line-height:1.15;margin-bottom:24px;letter-spacing:-0.5px;">
      {{ section.settings.heading | default: settings.brand_slogan }}
    </h1>
    <p style="font-size:clamp(16px, 2vw, 20px);opacity:0.9;margin-bottom:48px;font-weight:300;line-height:1.8;max-width:600px;margin-left:auto;margin-right:auto;">
      {{ section.settings.subheading | default: settings.brand_description }}
    </p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      {% if section.settings.btn1_text != blank %}
        <a href="{{ section.settings.btn1_link }}" class="btn btn-primary">
          {{ section.settings.btn1_text }}
        </a>
      {% endif %}
      {% if section.settings.btn2_text != blank %}
        <a href="{{ section.settings.btn2_link }}" class="btn btn-outline">
          {{ section.settings.btn2_text }}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div style="position:absolute;bottom:40px;left:50%;transform:translateX(-50%);animation:bounce 2s infinite;">
    <div style="width:1px;height:60px;background:linear-gradient(to bottom, transparent, rgba(255,255,255,0.4), transparent);"></div>
  </div>
</section>

<style>
@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(-10px); }
}
</style>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "专注高品质石英砖，定义建筑美学"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "深耕建筑材料领域15余年，坤博建材凭借深厚行业积淀与卓越产品品质，成为石英砖行业标杆品牌。"
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 Text",
      "default": "探索产品"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 Text",
      "default": "联系我们"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link",
      "default": "/pages/contact"
    }
  ],
  "presets": [{ "name": "Hero Banner", "category": "Kun Bloom" }]
}
{% endschema %}
