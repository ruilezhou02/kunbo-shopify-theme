<!-- Hero Banner — Full-bleed, typographic, architectural -->
<section class="hero-section" data-section-type="hero-banner">
  <div class="hero-bg">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Kun Bloom Architectural Stone">
    {% else %}
      <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Architectural Stone">
    {% endif %}
  </div>
  <div class="hero-content">
    <p class="eyebrow reveal">Est. 2010 &mdash; Chongqing, China</p>
    <h1 class="display-xl reveal reveal-delay-1">Stone is our<br>language.</h1>
    <p class="reveal reveal-delay-2">Premium quartz porcelain tiles for architects and designers who demand permanence, precision, and quiet beauty.</p>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}
