<!-- Hero Banner — Cinematic, full-bleed, parallax -->
<section class="hero-section" data-section-type="hero-banner">
  <div class="hero-bg">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Kun Bloom Architectural Stone">
    {% else %}
      <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Architectural Stone">
    {% endif %}
  </div>
  <div class="hero-content">
    <h1 class="display-xl reveal reveal-delay-1">{{ section.settings.heading_line1 }}<br>{{ section.settings.heading_line2 }}</h1>
    <p class="reveal reveal-delay-2">{{ section.settings.subtitle }}</p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="{{ section.settings.btn1_link }}" class="hero-btn hero-btn-primary">{{ section.settings.btn1_text }}</a>
      <a href="{{ section.settings.btn2_link }}" class="hero-btn hero-btn-outline">{{ section.settings.btn2_text }}</a>
    </div>
  </div>
  <div class="hero-scroll-indicator">
    <span>{{ section.settings.scroll_text }}</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading — Line 1",
      "default": "Premium Quartz Tiles."
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading — Line 2",
      "default": "Extraordinary Architectural Aesthetics."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Over 15 years of expertise in building materials — specializing in high-quality quartz tiles and architectural facade solutions."
    },
    {
      "type": "text",
      "id": "btn1_text",
      "label": "Button 1 — Text",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 — Link",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "btn2_text",
      "label": "Button 2 — Text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 — Link",
      "default": "/pages/contact"
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll Indicator Text",
      "default": "Scroll"
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}