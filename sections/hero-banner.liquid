<!-- Hero Banner — Block-based, cinematic full-screen -->
<section class="hero-section" role="banner" aria-label="Welcome">
  <div class="hero-bg" data-parallax>
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="{{ section.settings.hero_image.alt | escape }}">
    {% else %}
      <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Architectural Stone">
    {% endif %}
  </div>
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign delay = forloop.index | minus: 1 -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h1 class="display-xl reveal reveal-delay-{{ delay }}" {{ block.shopify_attributes }}>
              {{ block.settings.text | newline_to_br }}
            </h1>
          {%- when 'text' -%}
            <p class="reveal reveal-delay-{{ delay }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </p>
          {%- when 'button' -%}
            {%- if forloop.index == 1 -%}
              <div class="hero-actions reveal reveal-delay-{{ delay }}" {{ block.shopify_attributes }}>
            {%- endif -%}
            <a href="{{ block.settings.link }}" class="hero-btn {% if block.settings.style == 'primary' %}hero-btn-primary{% else %}hero-btn-outline{% endif %}">
              {{ block.settings.label }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' and forloop.last -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <h1 class="display-xl reveal reveal-delay-1">Premium<br>Quartz Tiles.<br>Extraordinary Architectural Aesthetics.</h1>
      <p class="reveal reveal-delay-2">Over 16 years of expertise in building materials — specializing in high-quality quartz tiles and architectural facade solutions.</p>
      <div class="hero-actions reveal reveal-delay-3">
        <a href="/collections" class="hero-btn hero-btn-primary">Explore Products</a>
        <a href="/pages/contact" class="hero-btn hero-btn-outline">Contact Us</a>
      </div>
    {%- endif -%}
  </div>

  {% if section.settings.show_scroll_indicator %}
  <div class="hero-scroll-indicator">
    <div class="hero-scroll-line"></div>
    <span>{{ section.settings.scroll_text }}</span>
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    },
    {
      "type": "text",
      "id": "scroll_text",
      "label": "Scroll indicator text",
      "default": "Scroll"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Heading",
          "default": "Premium Quartz Tiles.\nExtraordinary Architectural Aesthetics."
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Subtitle",
          "default": "Over 16 years of expertise in building materials — specializing in high-quality quartz tiles and architectural facade solutions."
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Explore Products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link",
          "default": "/collections"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" },
        { "type": "button", "settings": { "label": "Contact Us", "link": "/pages/contact", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
