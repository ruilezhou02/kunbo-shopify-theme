<!-- Hero Banner — Full-bleed, typographic, architectural -->
<section class="hero-section" data-section-type="hero-banner">
  <div class="hero-bg">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | img_url: 'master' }}" alt="Kun Bloom Architectural Stone">
    {% else %}
      <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Architectural Stone">
    {% endif %}
  </div>
  <div class="hero-content">
    <h1 class="display-xl reveal reveal-delay-1">Premium Quartz Tiles.<br>Extraordinary Architectural Aesthetics.</h1>
    <p class="reveal reveal-delay-2">Over 15 years of expertise in building materials — specializing in high-quality quartz tiles and architectural facade solutions.</p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="/collections" class="hero-btn hero-btn-primary">Explore Products</a>
      <a href="/pages/contact" class="hero-btn hero-btn-outline">Contact Us</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image"
    }
  ],
  "presets": [{ "name": "Hero Banner" }]
}
{% endschema %}