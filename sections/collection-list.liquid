<!-- Collection List — Block-based -->
<section class="collection-list" data-section-type="collection-list">
  <div class="section-container">
    <h2 class="display-md collection-list__title reveal">{{ section.settings.title }}</h2>

    <div class="collection-list__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
        -%}
        <a href="{{ collection.url }}" class="collection-card reveal reveal-delay-{{ forloop.index | modulo: 3 | plus: 1 }}" {{ block.shopify_attributes }}>
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              <img src="{{ collection.featured_image | img_url: '800x' }}"
                   alt="{{ collection.title | escape }}"
                   loading="lazy"
                   width="800"
                   height="600">
            {%- elsif collection.products.first.featured_image -%}
              <img src="{{ collection.products.first.featured_image | img_url: '800x' }}"
                   alt="{{ collection.title | escape }}"
                   loading="lazy"
                   width="800"
                   height="600">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-card__info">
            <h3>{{ collection.title }}</h3>
            <span class="collection-card__count">{{ collection.all_products_count }} products</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
