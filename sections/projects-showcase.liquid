<!-- Projects Showcase — Reference layout: eyebrow + title, view-more button, 3-card grid -->
<section class="projects-section" data-section-type="projects-showcase">
  <div class="projects-section-header">
    <div>
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="display-md reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>
    <a href="/pages/projects" class="view-more-btn reveal reveal-delay-2">{{ section.settings.view_all_text }}</a>
  </div>

  <div class="projects-grid">
    {% for i in (1..3) %}
      {%- capture image_id -%}project_image_{{ i }}{%- endcapture -%}
      {%- capture title_id -%}project_{{ i }}_title{%- endcapture -%}
      {%- capture location_id -%}project_{{ i }}_location{%- endcapture -%}
      {%- capture area_id -%}project_{{ i }}_area{%- endcapture -%}

      <article class="project-card reveal reveal-delay-{{ i }}">
        <div class="project-card-image">
          {% if section.settings[image_id] != blank %}
            <img src="{{ section.settings[image_id] | img_url: '800x' }}" alt="{{ section.settings[title_id] }}" class="placeholder-img">
          {% else %}
            <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Project" class="placeholder-img">
          {% endif %}
        </div>
        <div class="project-card-info">
          <h3>{{ section.settings[title_id] }}</h3>
          <p class="project-meta">
            <span>{{ section.settings[location_id] }}</span>
            <span class="meta-divider">|</span>
            <span>{{ section.settings[area_id] }}</span>
          </p>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

