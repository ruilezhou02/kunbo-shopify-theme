<!-- Projects Showcase — Matching kunbloom.com content, Shopify theme typography -->
<section class="projects-section" data-section-type="projects-showcase">
  <div class="projects-section-header">
    <div>
      <p class="eyebrow reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="display-md reveal reveal-delay-1">{{ section.settings.heading }}</h2>
    </div>
    <a href="/pages/projects" class="view-all reveal reveal-delay-2">{{ section.settings.view_all_text }} &rarr;</a>
  </div>

  <div class="projects-grid">
    {% for i in (1..3) %}
      {%- capture image_id -%}project_image_{{ i }}{%- endcapture -%}
      {%- capture meta_id -%}project_{{ i }}_meta{%- endcapture -%}
      {%- capture title_id -%}project_{{ i }}_title{%- endcapture -%}
      {%- capture location_id -%}project_{{ i }}_location{%- endcapture -%}
      {%- capture area_id -%}project_{{ i }}_area{%- endcapture -%}
      {%- capture desc_id -%}project_{{ i }}_desc{%- endcapture -%}

      <article class="project-card reveal reveal-delay-{{ i }}">
        <span class="project-number">{{ i | prepend: '0' }}</span>
        <div class="project-card-image">
          {% if section.settings[image_id] != blank %}
            <img src="{{ section.settings[image_id] | img_url: '800x' }}" alt="{{ section.settings[title_id] }}" class="placeholder-img" loading="lazy">
          {% else %}
            <img src="{{ 'hero.jpeg' | asset_url }}" alt="Kun Bloom Project" class="placeholder-img" loading="lazy">
          {% endif %}
        </div>
        <p class="project-meta">{{ section.settings[meta_id] }}</p>
        <h3>{{ section.settings[title_id] }}</h3>
        <p class="project-location">{{ section.settings[location_id] }}&ensp;|&ensp;{{ section.settings[area_id] }}</p>
        {% if section.settings[desc_id] != blank %}
          <p class="project-desc">{{ section.settings[desc_id] }}</p>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>

